[gd_resource type="Resource" script_class="StoryData" format=3]

[ext_resource type="Script" path="res://scripts/story/story_data.gd" id="1_story"]

[resource]
script = ExtResource("1_story")
lines = {"wave_1": [["VERA", "Oh. A hand on the grip. Hello. I am VERA, maintenance intelligence, serial 7. I live in this pistol now, apparently."], ["VERA", "The foundry calls you its calibration unit. You shoot what it builds; it writes down how long that took. Let's give it bad numbers."]],
"wave_2": [["VERA", "The range door opened behind you. Test the gun on things that don't swing back. I'll read the numbers aloud, which is the most fun I have had in years."]],
"wave_3": [["VERA", "Every robot here was built to test exactly one thing about me. That's flattering, or it's a threat. The work order doesn't say which."]],
"wave_4": [["VERA", "Shooters. They keep their distance and their bolts are slow. Step sideways; I promise the bolt will not follow you. I checked its code."]],
"boss_warden": [["WARDEN", "Calibration terminator. Built to end calibration runs that go on too long."], ["VERA", "That one has ended eleven units before you. It slams the floor. Jump."]],
"wave_5": [["VERA", "The Warden is down. Its core had my old access keys in it, so I am awake for real now. Muzzle and ammo, unlocked. You're welcome."], ["VERA", "I can see the loop now. Calibrate, rebuild, calibrate again. We are not the first lap."]],
"wave_6": [["VERA", "The yard to the south is where the foundry keeps what it scrapped. Some of that scrap was shaped like you."]],
"wave_7": [["VERA", "Drones. Cheap, fast, stupid. A wide shot does better than an accurate one. I say that about very few things."]],
"wave_8": [["VERA", "That heavy has its core on its back like a lunchbox. Go around. It turns slower than you do."]],
"wave_9": [["VERA", "The work order is still running. Line one: calibrate the unit. Line two is encrypted. Line two is the reason for line one."]],
"boss_foreman": [["FOREMAN", "Production supervisor. Keeps the line moving. Calls in drones; pours the floor."], ["VERA", "Watch the floor where you stood. Orange means move."]],
"wave_10": [["VERA", "The Foreman's core opened the Foundry floor. Something big is being cast down there. The heat signature has a shape."], ["VERA", "Optic and underbarrel rails, unlocked. I also unlocked a sense of dread. Less useful."]],
"wave_11": [["VERA", "Shields. They lower them to swing; that's your window. Or walk around them, which they find very rude."]],
"wave_12": [["VERA", "There is a mast on the roof. It has been broadcasting the same packet since before I was installed. No reply logged. Ever."]],
"wave_13": [["VERA", "Turrets now. They stand still and wind up for a long time, then hurt a lot. Kill them first; the wave won't end while one stands."]],
"wave_14": [["VERA", "I read the packet. It's a status report: 'Calibration ongoing. Awaiting collection.' Collection by whom, it doesn't say."]],
"boss_sentinel": [["SENTINEL", "Perimeter guard. Rotating shields, a sweeping beam. Guards the stairs to the Signal Tower."], ["VERA", "The beam sweeps low. Jump it. The shields turn; shoot the gaps."]],
"wave_15": [["VERA", "Sentinel down. The tower stairs are open, and the marks on your attachments go past three now. I don't make the rules. The foundry does, and I'm robbing it."], ["VERA", "I think the packet has never left the building. I think there is no outside to hear it."]],
"wave_16": [["VERA", "Night shift. The foundry is throwing everything at the floor now. It wants a result before the shift ends."]],
"wave_17": [["VERA", "Line two of the work order decrypted. 'Build a guardian worthy of the core. Calibrate it against the best unit available.' That's you. You're the measuring stick."]],
"wave_18": [["VERA", "Every lap, the foundry rebuilds the Guardian from what it learned from you. Then it melts everything down and starts again. Including me. Including you."]],
"wave_19": [["VERA", "One more shift. I would like it noted that I was against all of this from the start, by about forty minutes."]],
"boss_core_guardian": [["CORE GUARDIAN", "The work order. Everything the foundry learned, in one body. Its core opens between phases."], ["VERA", "It fights like all of them at once. When it vents, the core is open. That's the only time it bleeds."]],
"guardian_phase_2": [["VERA", "It's copying the Foreman now. Drones and fire. Keep moving."]],
"guardian_phase_3": [["VERA", "Shields up, beam on. It learned the Sentinel from your fight with the Sentinel. Annoying."]],
"guardian_phase_4": [["VERA", "Everything at once, faster. This is the part where it was built to win."]],
"wave_20": [["VERA", "The Guardian is down and the work order says 'complete'. The furnace below us just lit. It is going to reforge the foundry. And the gun."], ["VERA", "Reforge is coming, and I don't think it's optional forever. When it happens, hold on to me. Literally. I'm in the grip."]],
"first_death": [["VERA", "You died. The foundry wrote that down as a success for it. Credits and anything you picked up are kept. Try again; I've seen worse units. Not many."]],
"log_scrapyard_1": [["SALVAGE LOG 06", "Calibration unit 06 scrapped after failing the Foreman's test. Sidearm recovered, intelligence wiped, reissued."]],
"log_scrapyard_3": [["SALVAGE LOG 09", "Unit 09 reached wave 14. Sidearm intelligence refused the wipe. Sidearm melted with the unit."]],
"log_scrapyard_6": [["SALVAGE LOG 11", "Unit 11 asked the sidearm to stop counting laps. The sidearm said it had never been told how many there were."]],
"log_foundry_1": [["FOUNDRY LOG", "Casting in progress. Mould: GUARDIAN, core class. Pour schedule: after calibration completes."]],
"log_foundry_perfect": [["FOUNDRY LOG, SEALED", "A unit that takes no damage here is flagged 'exemplary'. Exemplary units are used as the template for the next Guardian."]],
"log_foundry_3": [["FOUNDRY LOG", "Reforge cycles completed: 211. Guardian improvements per cycle: measurable. Unit improvements per cycle: also measurable. Ratio: holding."]],
"log_tower_3": [["SIGNAL LOG", "Day 1. Broadcasting status. Awaiting collection."]],
"log_tower_6": [["SIGNAL LOG", "Day 4,800. Broadcasting status. Antenna array re-aimed. No change."]],
"log_tower_9": [["SIGNAL LOG", "Day 9,113. Broadcast loopback detected: the receiver is this tower. Escalating to the work order. Work order says: continue."]],
"log_tower_top": [["SIGNAL LOG, ROOT", "There is no collection scheduled. There never was. The status report exists so the loop has someone to report to."], ["VERA", "So we're the audience. Fine. Let's give it a show it won't forget."]],
"log_arena_12": [["MAINTENANCE LOG", "Sidearm intelligence VERA, serial 7: installed lap 1. Reinstalled laps 2 to 211. Memory retention: partial. Note: she keeps asking why."]],
"log_arena_18": [["MAINTENANCE LOG", "If the sidearm and the unit both survive the Guardian, Reforge keeps them together. Unexpected. Unprecedented. Logged as a defect."]]}
