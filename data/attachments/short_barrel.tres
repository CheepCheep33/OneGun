[gd_resource type="Resource" script_class="AttachmentDefinition" format=3]

[ext_resource type="Script" path="res://scripts/weapons/attachment_definition.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/weapons/stat_modifier.gd" id="2_mod"]

[sub_resource type="Resource" id="Mod_1"]
script = ExtResource("2_mod")
stat = &"fire_rate"
flat = 0.0
percent = 0.2

[sub_resource type="Resource" id="Mod_2"]
script = ExtResource("2_mod")
stat = &"range"
flat = 0.0
percent = -0.2

[resource]
script = ExtResource("1_def")
id = &"short_barrel"
display_name = "Short barrel"
slot = &"barrel"
description = "Cycles faster but throws shots wide: adds 1.5 degrees of spread and loses range."
modifiers = Array[ExtResource("2_mod")]([SubResource("Mod_1"), SubResource("Mod_2")])
mark_scale = 0.15
behaviours = {"added_spread": 1.5}
is_default = false
unlock_wave = 0
gate_text = ""
unlock_flag = ""
visual = {"slide_length": 0.82}
