[resource]
script = ExtResource("1_def")
id = &"explosive_rounds"
display_name = "Explosive rounds"
slot = &"ammo"
description = "Simulated shells that burst where they stop: 60% of the hit on the target and 60% to every robot within 2.5 m. Blasts never crit and never proc. Slower to cycle."
modifiers = Array[ExtResource("2_mod")]([SubResource("Mod_1"), SubResource("Mod_2")])
mark_scale = 0.15
behaviours = {"projectile": "shell", "blast_radius": 2.5, "projectile_color": Color(1, 0.5, 0.15, 1)}
is_default = false
unlock_wave = 0
gate_text = ""
visual = {"slide_color": Color(0.45, 0.3, 0.12, 1)}
legendary_name = "Sunburst"
legendary_description = "Every blast sets what it hits burning, as Incendiary rounds do."
legendary_modifiers = Array[ExtResource("2_mod")]([])
legendary_behaviours = {"blast_burn": true}
