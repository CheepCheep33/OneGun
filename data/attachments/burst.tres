unlock_flag = "foundry"
visual = {"slide_color": Color(0.12, 0.2, 0.36, 1)}
legendary_name = "Triplet"
legendary_description = "The last round of every burst is always a critical hit."
legendary_modifiers = Array[ExtResource("2_mod")]([SubResource("Mod_3")])
legendary_behaviours = {"burst_final_crit": true}
