[resource]
script = ExtResource("1_def")
id = &"burst"
display_name = "Burst"
slot = &"receiver"
description = "Three rounds per pull that each hit harder, at a slower sustained rate. No single shots."
modifiers = Array[ExtResource("2_mod")]([SubResource("Mod_1"), SubResource("Mod_2")])
mark_scale = 0.15
behaviours = {"fire_mode": "burst", "burst_size": 3}
is_default = false
unlock_wave = 0
