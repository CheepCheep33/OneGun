[resource]
script = ExtResource("1_def")
id = &"charge"
display_name = "Charge"
slot = &"receiver"
description = "Hold the trigger to charge one heavy simulated shot, up to three times the damage at full charge (0.9 s); release to fire. With Explosive rounds the blast grows with the charge."
