behaviours = {"fire_mode": "charge", "charge_time": 0.9, "projectile_color": Color(0.55, 0.85, 1, 1)}
is_default = false
unlock_wave = 0
gate_text = "Opens when the Signal Tower is cleared"
unlock_flag = "signal_tower"
visual = {"slide_color": Color(0.15, 0.35, 0.5, 1), "slide_length": 1.1}
