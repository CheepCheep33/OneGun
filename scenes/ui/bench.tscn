[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/bench.gd" id="1_bench"]

[sub_resource type="StyleBoxFlat" id="Style_panel"]
bg_color = Color(0.1, 0.11, 0.14, 0.92)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3, 0.33, 0.4, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="Bench" type="CanvasLayer"]
process_mode = 3
layer = 5
visible = false
script = ExtResource("1_bench")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.03, 0.05, 0.8)

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 34
text = "THE BENCH"

[node name="CreditsLabel" type="Label" parent="Margin/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.4, 1)
theme_override_font_sizes/font_size = 30
text = "CREDITS  0"
horizontal_alignment = 2

[node name="Greeting" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
modulate = Color(1, 1, 1, 0.8)
theme_override_font_sizes/font_size = 16
text = "Spend credits on your pistol between waves."
autowrap_mode = 3

[node name="Body" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 14

[node name="CorePanel" type="PanelContainer" parent="Margin/VBox/Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.15
theme_override_styles/panel = SubResource("Style_panel")

[node name="Margin" type="MarginContainer" parent="Margin/VBox/Body/CorePanel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="VBox" type="VBoxContainer" parent="Margin/VBox/Body/CorePanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Heading" type="Label" parent="Margin/VBox/Body/CorePanel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.85, 1, 1)
theme_override_font_sizes/font_size = 20
text = "CORE TUNING"

[node name="Blurb" type="Label" parent="Margin/VBox/Body/CorePanel/Margin/VBox"]
layout_mode = 2
modulate = Color(1, 1, 1, 0.7)
theme_override_font_sizes/font_size = 13
text = "Numbers only, never behaviour. Always safe to buy. Prices rise 15% per level."
autowrap_mode = 3

[node name="CoreRows" type="VBoxContainer" parent="Margin/VBox/Body/CorePanel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Separator" type="HSeparator" parent="Margin/VBox/Body/CorePanel/Margin/VBox"]
layout_mode = 2

[node name="SummaryHeading" type="Label" parent="Margin/VBox/Body/CorePanel/Margin/VBox"]
layout_mode = 2
