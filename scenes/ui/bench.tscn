theme_override_font_sizes/font_size = 16
text = "YOUR PISTOL"

[node name="StatsSummary" type="Label" parent="Margin/VBox/Body/CorePanel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 15
