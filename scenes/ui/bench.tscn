[node name="Footer" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="Hint" type="Label" parent="Margin/VBox/Footer"]
layout_mode = 2
size_flags_horizontal = 3
modulate = Color(1, 1, 1, 0.6)
theme_override_font_sizes/font_size = 13
text = "Progress saves here. Dying keeps your credits. Esc during a wave pauses; the pause menu has options and Abandon wave."

[node name="ResetButton" type="Button" parent="Margin/VBox/Footer"]
unique_name_in_owner = true
layout_mode = 2
modulate = Color(1, 0.7, 0.7, 1)
text = "Reset progress"
